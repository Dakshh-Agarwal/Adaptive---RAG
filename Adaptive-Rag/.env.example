# ─── REQUIRED: GET BEFORE STARTING ───────────────────────────
#
# 1. GOOGLE_API_KEY
#    → Go to: https://aistudio.google.com/app/apikey
#    → Sign in → "Create API Key" → copy it
#    → Free tier: 15 requests/min, 1500 requests/day
#
GOOGLE_API_KEY=your_google_gemini_api_key_here

# 2. TAVILY_API_KEY (for web search feature)
#    → Go to: https://app.tavily.com
#    → Sign up → Dashboard → copy API key
#    → Free tier: 1000 searches/month
#
TAVILY_API_KEY=your_tavily_api_key_here

# ─── MONGODB ──────────────────────────────────────────────────
#
# LOCAL (Docker): use this as-is
MONGODB_URI=mongodb://localhost:27017
#
# ATLAS (Cloud Free Tier):
# → Go to: https://cloud.mongodb.com
# → Create free cluster → Connect → Copy connection string
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/

# ─── QDRANT VECTOR DB (optional — currently disabled) ─────────
# Currently using FAISS in-memory (no setup needed).
# Uncomment below ONLY if you switch back to Qdrant in retriever_setup.py
#
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# QDRANT_CODE_COLLECTION=codebase
# QDRANT_DOCS_COLLECTION=guidelines
